<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow outbound network connections (required for SSH/SFTP) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Allow inbound network connections (for reverse tunnels / port forwarding) -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Required by Electron's V8 JIT engine under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- NOTE: com.apple.security.cs.allow-unsigned-executable-memory was removed.
       Its old comment claimed native modules needed it; they do not. That key is
       the legacy pre-allow-jit workaround, and V8's JIT is already covered by
       com.apple.security.cs.allow-jit above. Keeping it disabled one of the main
       hardened-runtime memory protections for no benefit. -->

  <!-- Allow loading the bundled native addons (.node) under hardened runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
