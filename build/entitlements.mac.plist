<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow outbound network connections (required for SSH/SFTP) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Allow inbound network connections (for reverse tunnels / port forwarding) -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Required by Electron's V8 JIT engine under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Required for native modules (better-sqlite3, ssh2) under hardened runtime -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow dynamic library loading for native addons -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
